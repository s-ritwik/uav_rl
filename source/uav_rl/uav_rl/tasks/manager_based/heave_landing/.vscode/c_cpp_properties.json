{
  "configurations": [
    {
      "browse": {
        "databaseFilename": "${workspaceFolder}/.vscode/browse.vc.db",
        "limitSymbolsToIncludedHeaders": false
      },
      "includePath": [
        "${env:HOME}/projects/ros2_ws/install/precision_landing_using_vision/include/**",
        "${env:HOME}/projects/ros2_ws/install/precision_landing_using_vision_msgs/include/**",
        "${env:HOME}/projects/ros2_ws/src/install/precision_landing_using_vision/include/**",
        "${env:HOME}/projects/ros2_ws/src/install/precision_landing_using_vision_msgs/include/**",
        "/opt/ros/humble/include/**",
        "/usr/include/**"
      ],
      "name": "ros2",
      "intelliSenseMode": "gcc-x64",
      "compilerPath": "/usr/bin/gcc",
      "cStandard": "gnu11",
      "cppStandard": "c++17"
    }
  ],
  "version": 4
}
